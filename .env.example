# Staging uses SQLite so the environment is reproducible with one command.
# Production target is Postgres — swap the provider in prisma/schema.prisma and
# point this at the Postgres URL.
DATABASE_URL="file:./staging.db"

# Absolute origin, used to build QR payloads that must resolve off-device
# (a phone scanning a table tent is not on localhost).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Renders the "STAGING" banner and enables seed/reset affordances.
# Must be "false" in production.
NEXT_PUBLIC_STAGING="true"
